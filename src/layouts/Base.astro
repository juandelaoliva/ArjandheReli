---
import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/latin-ext-400.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '@fontsource/playfair-display/latin-ext-400-italic.css';
import '@fontsource-variable/jost/index.css';
import '@fontsource/pinyon-script/latin-400.css';
import '@fontsource/pinyon-script/latin-ext-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-ext-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/relieve.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { langs, type Lang } from '../i18n/ui';
import { textureVars } from '../lib/textures';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (file: string) => `${base}${file}`;
// WhatsApp y las redes necesitan direcciones completas (https://…) para la imagen de vista previa.
const absolute = (file: string) => new URL(asset(file), Astro.site).href;
---

<!doctype html>
<html lang={lang} style={textureVars} data-style="relieve">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fafaf7" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
    <link rel="icon" href={asset('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={asset('icon-192.png')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={absolute('og.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={absolute('og.jpg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang} />
  </head>
  <body>
    <slot />
  </body>
</html>
