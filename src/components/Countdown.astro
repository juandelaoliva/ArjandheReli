---
import Wash from './Wash.astro';
import { boda } from '../data/boda';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const diff = Math.max(0, new Date(boda.fecha).getTime() - Date.now());
const initial = {
  days: Math.floor(diff / 864e5),
  hours: Math.floor((diff % 864e5) / 36e5),
  minutes: Math.floor((diff % 36e5) / 6e4),
};
---

<section class="section countdown" aria-label={t.countdownCaption}>
  <Wash seed={5} tone={2} size="26rem" x="12%" y="40%" rot={20} opacity={0.9} />
  <Wash seed={9} tone={1} size="22rem" x="92%" y="60%" rot={-30} opacity={0.8} />
  <div class="wrap">
    <p class="caption">{t.countdownCaption}</p>
    <div class="units" data-countdown data-date={boda.fecha} role="timer">
      <div class="unit"><span class="num" data-unit="days">{initial.days}</span><span class="lab">{t.days}</span></div>
      <div class="unit"><span class="num" data-unit="hours">{initial.hours}</span><span class="lab">{t.hours}</span></div>
      <div class="unit"><span class="num" data-unit="minutes">{initial.minutes}</span><span class="lab">{t.minutes}</span></div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-countdown]');
  if (root) {
    const target = new Date(root.dataset.date!).getTime();
    const els = {
      days: root.querySelector('[data-unit="days"]')!,
      hours: root.querySelector('[data-unit="hours"]')!,
      minutes: root.querySelector('[data-unit="minutes"]')!,
    };
    const tick = () => {
      const d = Math.max(0, target - Date.now());
      els.days.textContent = String(Math.floor(d / 864e5));
      els.hours.textContent = String(Math.floor((d % 864e5) / 36e5));
      els.minutes.textContent = String(Math.floor((d % 36e5) / 6e4));
    };
    tick();
    setInterval(tick, 30000);
  }
</script>

<style>
  .countdown {
    padding-block: 1.75rem;
    text-align: center;
  }

  .caption {
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
  }

  .units {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
    max-width: 22rem;
    margin-inline: auto;
  }

  /* Tres cajas iguales, con el mismo fondo que el hueco de la foto. */
  .unit {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.35rem;
    aspect-ratio: 1 / 1.05;
    padding: 0.5rem;
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--wash-1) 35%, var(--algodon));
  }

  .num {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 11vw, 3.2rem);
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .lab {
    font-size: var(--step--1);
    letter-spacing: 0.12em;
  }
</style>
