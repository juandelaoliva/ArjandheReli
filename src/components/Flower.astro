---
// Flor suelta de acuarela, posicionada en % del contenedor (que debe ser position: relative).
import Blossom from './Blossom.astro';

interface Props {
  seed?: number;
  tone?: 1 | 2 | 3;
  size?: string;
  x?: string;
  y?: string;
  rot?: number;
  opacity?: number;
  petals?: number;
}

const { seed = 1, tone = 2, size = '6rem', x = '50%', y = '50%', rot = 0, opacity = 1, petals = 6 } = Astro.props;
---

<svg
  class="flower"
  viewBox="-50 -50 100 100"
  aria-hidden="true"
  focusable="false"
  style={`--size:${size};left:${x};top:${y};opacity:${opacity};transform:translate(-50%,-50%) rotate(${rot}deg)`}
>
  <Blossom seed={seed} tone={tone} petals={petals} />
</svg>

<style>
  .flower {
    position: absolute;
    width: var(--size);
    height: var(--size);
    pointer-events: none;
    mix-blend-mode: multiply;
  }
</style>
