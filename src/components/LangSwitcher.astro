---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, langs, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<nav class="lang" aria-label={ui[lang].language}>
  {
    langs.map((l) => (
      <a
        href={getRelativeLocaleUrl(l)}
        hreflang={l}
        lang={l}
        aria-current={l === lang ? 'page' : undefined}
      >
        {languages[l]}
      </a>
    ))
  }
</nav>

<style>
  .lang {
    position: fixed;
    top: max(0.5rem, env(safe-area-inset-top));
    right: var(--gutter);
    z-index: 50;
    display: flex;
    gap: 0.25rem;
    font-size: var(--step--1);
    transition: color 0.6s ease;
  }

  /* Sobre el sobre, con el color de texto que toque según el color del sobre. */
  :global(html.intro-lock) .lang {
    color: var(--on-envelope);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 0.5rem;
    text-decoration: none;
    opacity: 0.65;
  }

  a[aria-current='page'] {
    opacity: 1;
    text-decoration: underline;
    text-decoration-color: var(--lacre);
    text-underline-offset: 0.3em;
  }
</style>
